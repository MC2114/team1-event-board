<% const isPast=variant==="past" ; %>

    <section class="mb-6 border rounded-xl overflow-hidden 
    <%= isPast ? 'border-slate-300 bg-slate-50/60' : 'border-slate-200 bg-white' %>">

        <!-- HEADER -->
        <div class="px-5 py-3 border-b flex items-center justify-between
        <%= isPast 
            ? 'bg-red-50 border-red-100' 
            : 'bg-slate-50 border-slate-200' %>">

            <h2 class="text-sm font-semibold uppercase tracking-wide
            <%= isPast ? 'text-red-600' : 'text-slate-600' %>">
                <%= title %>
            </h2>

            <% if (isPast) { %>
                <span class="text-xs text-red-500 font-medium">Inactive</span>
                <% } %>
        </div>

        <% if (items.length===0) { %>
            <div class="px-5 py-6 text-sm <%= isPast ? 'text-slate-400' : 'text-slate-500' %>">
                <%= emptyMessage %>
            </div>
            <% } else { %>

                <ul class="divide-y <%= isPast ? 'divide-slate-200' : 'divide-slate-100' %>">

                    <% items.forEach((item)=> { %>

                        <li class="flex justify-between gap-4 px-5 py-4 transition
            <%= isPast 
                ? 'bg-transparent text-slate-500' 
                : 'bg-white hover:bg-slate-50' %>">

                            <!-- LEFT -->
                            <div class="flex flex-col gap-1 min-w-0">

                                <a href="/events/<%= item.event.id %>" class="font-medium truncate
                   <%= isPast 
                        ? 'text-slate-500 hover:text-slate-700' 
                        : 'text-slate-800 hover:text-indigo-600 hover:underline' %>">
                                    <%= item.event.title %>
                                </a>

                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">

                                    <span>
                                        <%= item.event.startDatetime.toLocaleDateString("en-US", { month: "short" ,
                                            day: "numeric" , year: "numeric" }) %>
                                    </span>

                                    <span>•</span>

                                    <span>
                                        <%= item.event.location %>
                                    </span>

                                    <span>•</span>

                                    <span class="capitalize">
                                        <%= item.event.category %>
                                    </span>
                                </div>

                                <% if (item.conflictWarning && !isPast) { %>
                                    <div
                                        class="mt-2 text-xs text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1.5 rounded-md inline-flex items-center gap-1">
                                        ⚠️ <span>
                                            <%= item.conflictWarning %>
                                        </span>
                                    </div>
                                    <% } %>

                            </div>

                            <!-- RIGHT -->
                            <div class="flex items-center gap-3 shrink-0">

                                <% const statusStyles={ going: "bg-green-100 text-green-700" ,
                                    waitlisted: "bg-yellow-100 text-yellow-700" , cancelled: "bg-red-100 text-red-600" ,
                                    }; const style=statusStyles[item.status] ?? "bg-slate-100 text-slate-600" ; %>

                                    <span
                                        class="inline-block px-2 py-0.5 rounded-full text-xs font-medium capitalize <%= style %>">
                                        <%= item.status %>
                                    </span>

                                    <% if (showCancel) { %>
                                        <form method="post" action="/events/<%= item.eventId %>/rsvp" x-data
                                            @submit.prevent="if(confirm('Cancel this RSVP?')) $el.submit()">
                                            <button type="submit"
                                                class="text-xs px-3 py-1.5 rounded-lg border border-red-300 text-red-600 hover:bg-red-50 transition-colors">
                                                Cancel
                                            </button>
                                        </form>
                                        <% } %>

                            </div>

                        </li>

                        <% }) %>

                </ul>

                <% } %>
    </section>