<section class="mb-6 p-6 rounded-2xl border border-slate-200 shadow-sm 
    <%= title.includes('Upcoming') ? 'bg-white' : 'bg-slate-50' %>">

    <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-semibold text-slate-900 flex items-center gap-2">
            <% if (title.includes('Upcoming')) { %>
                <span>🟢</span>
                <% } else { %>
                    <span>🕘</span>
                    <% } %>
                        <%= title %>
        </h2>
    </div>

    <% if (items.length===0) { %>
        <div class="text-center py-8 text-slate-500 text-sm border border-dashed rounded-xl">
            <%= emptyMessage %>
        </div>
        <% } else { %>

            <ul class="grid gap-4">
                <% items.forEach((item)=> { %>

                    <li
                        class="group flex justify-between gap-4 p-5 rounded-xl border border-slate-200 bg-white hover:shadow-md hover:border-slate-300 transition">

                        <!-- LEFT CONTENT -->
                        <div class="flex flex-col gap-1 min-w-0">
                            <strong class="text-slate-900 text-base truncate group-hover:text-indigo-600 transition">
                                <%= item.event.title %>
                            </strong>

                            <p class="text-sm text-slate-500">
                                📍 <%= item.event.location %>
                            </p>

                            <p class="text-sm text-slate-500">
                                🗓
                                <%= item.event.startDatetime.toLocaleDateString("en-US", { weekday: "short" ,
                                    month: "short" , day: "numeric" , hour: "2-digit" , minute: "2-digit" }) %>
                            </p>

                            <p class="text-xs text-slate-400">
                                <span class="px-2 py-0.5 bg-slate-100 rounded-md capitalize">
                                    <%= item.event.category %>
                                </span>
                            </p>

                            <% if (item.conflictWarning) { %>
                                <div
                                    class="mt-2 text-xs text-amber-800 bg-amber-50 border border-amber-200 px-3 py-2 rounded-lg flex gap-2">
                                    ⚠️ <span>
                                        <%= item.conflictWarning %>
                                    </span>
                                </div>
                                <% } %>
                        </div>

                        <!-- RIGHT SIDE -->
                        <div class="flex flex-col items-end gap-3 shrink-0">

                            <% const statusStyles={ going: "bg-emerald-100 text-emerald-700" ,
                                waitlisted: "bg-amber-100 text-amber-700" , cancelled: "bg-rose-100 text-rose-700" , };
                                const style=statusStyles[item.status] ?? "bg-slate-100 text-slate-600" ; %>

                                <span class="px-3 py-1 text-xs font-semibold rounded-full capitalize <%= style %>">
                                    <%= item.status %>
                                </span>

                                <% if (showCancel) { %>
                                    <form method="post" action="/events/<%= item.eventId %>/rsvp" x-data
                                        @submit.prevent="if(confirm('Cancel this RSVP?')) $el.submit()">
                                        <button type="submit" class="text-sm px-3 py-1.5 rounded-lg border border-red-200 text-red-600 
                               hover:bg-red-600 hover:text-white transition font-medium">
                                            Cancel
                                        </button>
                                    </form>
                                    <% } %>

                        </div>

                    </li>

                    <% }) %>
            </ul>

            <% } %>
</section>